{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "subscription-development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "plus-beta"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "proof"
      }
    },
    "e2e-test": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://127.0.0.1:1/api",
        "EXPO_PUBLIC_ENABLE_NATIVE_PLUS_PURCHASES": "false",
        "EXPO_PUBLIC_LAUNCH_PHASE": "proof",
        "EXPO_PUBLIC_NATIVE_E2E_FIXTURES": "maestro-proof-v1",
        "EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY": "",
        "EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY": "",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "",
        "EXPO_PUBLIC_SUPABASE_URL": ""
      }
    },
    "plus-beta": {
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "plus-beta"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "proof"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal"
      }
    }
  }
}
