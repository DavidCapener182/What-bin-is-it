{
  "cli": {
    "version": ">= 21.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "proof"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "proof"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal"
      }
    }
  }
}
