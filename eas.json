{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "subscription-development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "plus-beta"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "proof"
      }
    },
    "plus-beta": {
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "plus-beta"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_COUNCIL_API_BASE": "https://what-bin-is-it-tonight.vercel.app/api",
        "EXPO_PUBLIC_LAUNCH_PHASE": "proof"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal"
      }
    }
  }
}
