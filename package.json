  "scripts": {
    "dev": "EXPO_PUBLIC_COUNCIL_API_BASE=https://what-bin-is-it-tonight.vercel.app/api expo start --web",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/generate-pwa.mjs",
    "build:server": "nitro build",
    "build": "npm run build:web && npm run build:server",
    "audit:production": "node scripts/audit-production.mjs",
    "councils:sync": "node --no-warnings --experimental-strip-types scripts/sync-council-pipeline.mjs",
    "lint": "eslint . --max-warnings=0",
    "store:check": "node scripts/verify-store-readiness.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mjs",
    "test:browser:resident": "playwright test -c tests/browser/playwright.config.mjs",
    "test:native:static": "node scripts/validate-native-journeys.mjs && node --no-warnings --experimental-strip-types --test tests/native-e2e-fixtures.test.mjs tests/native-release-journeys.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "overrides": {
    "@swc/cli": {
      "minimatch": {
        ".": "9.0.8",
        "brace-expansion": "5.0.9"
