    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.6",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "10.4.4",
    "react-native-purchases-ui": "10.4.4",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "web-push": "^3.6.7",
    "workflow": "^4.6.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "nitro": "^3.0.260610-beta",
    "typescript": "~6.0.3",
    "vite": "^7.3.6"
  },
  "scripts": {
    "dev": "EXPO_PUBLIC_COUNCIL_API_BASE=https://what-bin-is-it-tonight.vercel.app/api expo start --web",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/generate-pwa.mjs",
    "build:server": "nitro build",
    "build": "npm run build:web && npm run build:server",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "councils:sync": "node --no-warnings --experimental-strip-types scripts/sync-council-pipeline.mjs",
    "lint": "eslint . --max-warnings=0",
    "store:check": "node scripts/verify-store-readiness.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "overrides": {
    "@swc/cli": {
      "minimatch": "9.0.8"
    },
    "filelist": "2.0.2",
    "uuid": "11.1.1"
  },
  "private": true
}
