# Public URL of the deployed council gateway. Do not add provider credentials here.
EXPO_PUBLIC_COUNCIL_API_BASE=https://api.example.com

# Commercial launch staging. Keep `proof` for the first free store release.
EXPO_PUBLIC_LAUNCH_PHASE=proof

# Optional public address used only by the council/property partnership page.
EXPO_PUBLIC_PARTNERSHIP_EMAIL=

# Optional official council feed connectors. The JSON contains endpoint metadata
# only; keep each credential in its separately named server-side variable.
COUNCIL_PARTNER_REGISTRY_JSON=[]
# Example credential name referenced by the registry:
# COUNCIL_EXAMPLE_API_KEY=

# Web Push application-server keys. Generate a VAPID pair once and save both
# values as Vercel environment variables; never commit a real private key.
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
