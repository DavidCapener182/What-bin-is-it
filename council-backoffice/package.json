{
  "name": "what-bin-council-backoffice",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --port 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "staff:bootstrap": "node scripts/bootstrap-council-staff.mjs",
    "platform-admin:bootstrap": "node scripts/bootstrap-platform-admin.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run audit:production && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
