{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:api && npx expo export --platform web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/v1/[resource].js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "re": "^what-bin-is-it-tonight(?:-[a-z0-9]+)?-capener182-gmailcoms-projects\\.vercel\\.app$"
          }
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "preview"
        }
      ],
      "destination": "https://what-bin-is-it-tonight.vercel.app/$1",
      "permanent": false
    }
  ]
}
